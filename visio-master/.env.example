# ─────────────────────────────────────────────────────────────
# visio-master — Optional Fallback Configuration
# visio-master 可选 fallback 配置
# ─────────────────────────────────────────────────────────────

# This file is an optional fallback config source for visio-master scripts
# (image_gen.py, image_search.py, vsdx_export.py, vsdx_preview/server.py,
# graph_upload.py). Current process environment variables take precedence
# over this file.
# 当前文件是 visio-master 各脚本的可选 fallback 配置来源（image_gen.py、
# image_search.py、vsdx_export.py、vsdx_preview/server.py、graph_upload.py）。
# 当前进程环境变量优先于这个文件。
#
# Resolution order (only the FIRST existing file is read; keys are NOT merged
# across files) — identical to ppt-master:
#   1. ./.env in your current working directory
#   2. <skill-dir>/.env (skill install, e.g. ~/.agents/skills/visio-master/.env)
#   3. <repo-root>/.env (when running from a clone)
#   4. ~/.visio-master/.env (user-level config)
# 查找顺序（只读第一个存在的文件，多个 .env 之间不合并），与 ppt-master 一致：
#   1. 当前工作目录下的 ./.env
#   2. skill 安装目录下的 .env（如 ~/.agents/skills/visio-master/.env）
#   3. 仓库根目录下的 .env（仅在 clone 模式下）
#   4. ~/.visio-master/.env（用户级配置）

# ═════════════════════════════════════════════════════════════
# SECTION A — Visio Runtime (COM / pywin32) / Visio 运行时
# ═════════════════════════════════════════════════════════════

# Override path to the Visio executable. Only set this when registry
# discovery picks the wrong install (e.g. side-by-side C2R + MSI, or a
# non-default per-user install). Leave unset to let pywin32 resolve via
# the Visio.Application / Visio.InvisibleApp ProgID.
# 覆盖 Visio 可执行文件路径。仅当注册表发现拿到错误安装位置时设置
# （例如 C2R 与 MSI 并存，或非默认的 per-user 安装）。留空时由 pywin32
# 通过 Visio.Application / Visio.InvisibleApp ProgID 自行解析。
# VISIO_INSTALL_PATH=C:\Program Files\Microsoft Office\root\Office16\VISIO.EXE

# Use Visio.InvisibleApp (true) or Visio.Application (false).
# Default: true (no taskbar window, no splash screen, recommended for
# unattended export). Flip to false only for interactive debugging.
# 使用 Visio.InvisibleApp（true）还是 Visio.Application（false）。
# 默认：true（无任务栏窗口、无启动画面，推荐用于无人值守导出）。
# 仅在交互式调试时改为 false。
# VISIO_USE_INVISIBLE=true

# Force vsdx_export.py path: com / fallback / aspose / auto.
# Default: auto (COM if Visio is present, else fallback writer).
# vsdx_export.py 强制使用的导出路径：com / fallback / aspose / auto。
# 默认：auto（有 Visio 用 COM，否则用 fallback writer）。
# VSDX_EXPORT_BACKEND=auto

# COM session timeout in seconds. Long Container/List recalcs on large
# drawings can exceed the default; raise for >100-page exports.
# COM 会话超时（秒）。大型绘图的 Container/List 重算可能超过默认值；
# 大于 100 页的导出建议调高。
# VISIO_COM_TIMEOUT=300

# Kill any orphan VISIO.EXE process before opening a new COM session.
# Default: true (matches the cleanup pattern in research/06).
# 在打开新的 COM 会话前杀掉残留的 VISIO.EXE 进程。
# 默认：true（与 research/06 的清理模式一致）。
# VISIO_KILL_ORPHANS=true

# ═════════════════════════════════════════════════════════════
# SECTION B — Data Linking / 数据链接
# ═════════════════════════════════════════════════════════════

# Default timeout (seconds) for DataRecordset refresh operations on
# external CSV / XLSX / OLEDB sources. Stylist's data-graphics binding
# uses this when diagram_lock.page_data_links has entries.
# 外部 CSV / XLSX / OLEDB 数据源 DataRecordset 刷新的默认超时（秒）。
# 当 diagram_lock.page_data_links 有条目时，Stylist 的 data-graphics
# 绑定会使用这个值。
# DATA_LINK_DEFAULT_TIMEOUT=60

# Root for resolving relative data-link source paths declared in
# diagram_lock.page_data_links. Default: <project>/data_links/.
# 解析 diagram_lock.page_data_links 中相对数据源路径的根目录。
# 默认：<project>/data_links/。
# DATA_LINK_ROOT=

# ═════════════════════════════════════════════════════════════
# SECTION C — Microsoft Graph (OneDrive / SharePoint upload)
# Microsoft Graph（OneDrive / SharePoint 上传）
# ═════════════════════════════════════════════════════════════

# Optional. Only required when running scripts/graph_upload.py to push
# an exported .vsdx to OneDrive for Business or SharePoint Online.
# Local-only workflows do not need any of these.
# 可选。仅当通过 scripts/graph_upload.py 把导出的 .vsdx 推送到
# OneDrive for Business 或 SharePoint Online 时才需要配置。
# 纯本地流程无需设置。
#
# Register an Azure AD app, grant Files.ReadWrite.All (or Sites.Selected
# for SharePoint Embedded), and copy the three values below.
# 在 Azure AD 注册应用，授予 Files.ReadWrite.All（或 SharePoint Embedded
# 用 Sites.Selected），然后复制下面三个值。
#
# GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=your-client-secret

# OAuth scope. Default suits client-credentials flow (app-only).
# OAuth 范围。默认适用 client_credentials（仅应用）流程。
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# Default upload destination. Either a drive-relative path or a
# SharePoint site path; graph_upload.py auto-detects the form.
# 默认上传目的地。可以是 drive 相对路径，也可以是 SharePoint 站点路径；
# graph_upload.py 会自动判断。
# GRAPH_UPLOAD_PATH=/Drawings/visio-master/

# ═════════════════════════════════════════════════════════════
# SECTION D — Preview Server / 预览服务器
# ═════════════════════════════════════════════════════════════

# Port for scripts/vsdx_preview/server.py. Default: 5060.
# (ppt-master uses 5050; visio-master shifts to 5060 to allow both to
# run side-by-side.)
# scripts/vsdx_preview/server.py 的端口。默认：5060。
# （ppt-master 使用 5050；visio-master 改为 5060 以便两者并存。）
# VSDX_PREVIEW_PORT=5060

# Page render backend: com / aspose / libreoffice / auto.
# Default: auto (capability-detect order: COM → aspose → libreoffice).
# 页面渲染后端：com / aspose / libreoffice / auto。
# 默认：auto（能力探测顺序：COM → aspose → libreoffice）。
# VSDX_PREVIEW_BACKEND=auto

# Path to soffice (LibreOffice) for the headless render fallback.
# Leave unset to use PATH lookup.
# 用于 headless 渲染 fallback 的 soffice（LibreOffice）路径。
# 留空时按 PATH 查找。
# LIBREOFFICE_SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe

# ═════════════════════════════════════════════════════════════
# SECTION E — Optional Library Licenses / 可选库授权
# ═════════════════════════════════════════════════════════════

# Aspose.Diagram for Python license file path. Required only when
# VSDX_EXPORT_BACKEND=aspose or when the auto path falls back to it.
# Without a license, aspose.diagram runs in evaluation mode and
# stamps watermarks — not suitable for deliverables.
# Aspose.Diagram for Python 授权文件路径。仅当 VSDX_EXPORT_BACKEND=aspose
# 或 auto 路径回落到它时需要。没有授权时 aspose.diagram 处于评估模式
# 并会打水印，不适合用于交付物。
# ASPOSE_DIAGRAM_LICENSE=C:\path\to\Aspose.Diagram.lic

# Visio Online add-in client id (only relevant if you embed the
# preview iframe into an authenticated SharePoint page).
# Visio Online 加载项 client id（仅当把预览 iframe 嵌入到经过认证的
# SharePoint 页面时相关）。
# VISIO_ONLINE_CLIENT_ID=

# ═════════════════════════════════════════════════════════════
# SECTION F — Image Generation / 图片生成
# (Reused from ppt-master; image_gen.py is vendored verbatim.
# See ppt-master/.env.example for the full provider catalog.)
# 复用自 ppt-master；image_gen.py 原样引入。
# 完整 provider 目录见 ppt-master/.env.example。
# ═════════════════════════════════════════════════════════════

# Active backend (required when image_gen.py is invoked).
# Recommended core backends: openai / gemini / qwen / zhipu / volcengine
# image_gen.py 启用时必填。
# 推荐核心后端：openai / gemini / qwen / zhipu / volcengine
# IMAGE_BACKEND=openai

# IMPORTANT: IMAGE_API_KEY / IMAGE_MODEL / IMAGE_BASE_URL are no longer
# supported. Use provider-specific keys only.
# 重要：不再支持 IMAGE_API_KEY / IMAGE_MODEL / IMAGE_BASE_URL。
# 请只使用各提供商自己的变量。

# ── OpenAI (recommended / 推荐) ─────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-image-2
# OPENAI_BASE_URL=http://127.0.0.1:3000/v1
# OPENAI_SIZE_PRESET=auto
# OPENAI_RESPONSE_FORMAT=auto
# OPENAI_QUALITY=auto
# OPENAI_OUTPUT_FORMAT=png
# OPENAI_OUTPUT_COMPRESSION=80
# OPENAI_BACKGROUND=auto
# OPENAI_MODERATION=auto

# ── Gemini ──────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview
# GEMINI_BASE_URL=https://your-proxy-url.com

# ── Qwen / 通义生图 ─────────────────────────────────────────
# QWEN_API_KEY=your-dashscope-key
# QWEN_MODEL=qwen-image-2.0-pro
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# ── Zhipu / 智谱生图 ────────────────────────────────────────
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-image
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# ── Volcengine / 火山引擎 ───────────────────────────────────
# VOLCENGINE_API_KEY=your-volcengine-key
# VOLCENGINE_MODEL=doubao-seedream-4-5-251128
# VOLCENGINE_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1/images/generations

# ── MiniMax ─────────────────────────────────────────────────
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# Default China endpoint / 默认国内地址
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation
# Optional overseas endpoint / 可选海外地址
# MINIMAX_BASE_URL=https://api.minimax.io/v1/image_generation

# ── Other providers (uncomment as needed) ──────────────────
# STABILITY_API_KEY=your-stability-key
# STABILITY_MODEL=stable-image-core
# STABILITY_BASE_URL=https://api.stability.ai
# BFL_API_KEY=your-bfl-key
# BFL_MODEL=flux-pro-1.1-ultra
# BFL_BASE_URL=https://api.bfl.ai
# IDEOGRAM_API_KEY=your-ideogram-key
# IDEOGRAM_MODEL=ideogram-v3
# IDEOGRAM_BASE_URL=https://api.ideogram.ai
# SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_MODEL=Qwen/Qwen-Image
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations
# FAL_KEY=your-fal-key
# FAL_MODEL=fal-ai/imagen3/fast
# FAL_BASE_URL=https://fal.run
# REPLICATE_API_TOKEN=r8_xxx
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_BASE_URL=https://api.replicate.com/v1/predictions
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODELSCOPE_API_KEY=your-modelscope-key
# MODELSCOPE_MODEL=Tongyi-MAI/Z-Image-Turbo
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ═════════════════════════════════════════════════════════════
# SECTION G — Web Image Search / 网络图片搜索
# (image_search.py is reused from ppt-master.)
# image_search.py 复用自 ppt-master。
# ═════════════════════════════════════════════════════════════

# Openverse and Wikimedia work with no key, but image quality can be
# uneven. For polished stock-style diagrams, configure Pexels and/or
# Pixabay.
# Openverse 和 Wikimedia 无需 Key，但图片质量不稳定。
# 如需更稳定的商业图库风格配图，建议配置 Pexels 和/或 Pixabay。
#
# Sign up: https://www.pexels.com/api/
# PEXELS_API_KEY=your-pexels-key
# Sign up: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your-pixabay-key
